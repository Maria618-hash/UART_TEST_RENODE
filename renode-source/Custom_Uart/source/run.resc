
using sysbus
mach create "Custom_Uart"

# Load the platform description (the .repl file)
machine LoadPlatformDescription @custom_uart.repl
uart1_ST1 SimulationFilePathLinux @libVuart.so

sysbus LoadELF @hello.elf
 
sysbus LogPeripheralAccess uart1_ST1

showAnalyzer "uart_log" uart1_ST1 Antmicro.Renode.Analyzers.LoggingUartAnalyzer  
 
machine StartGdbServer 3333

# Create a UART analyzer (for console output)
showAnalyzer uart1_ST1

start



